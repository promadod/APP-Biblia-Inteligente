# Django

DJANGO_SECRET_KEY=change-me-in-production

DEBUG=1

ALLOWED_HOSTS=localhost,127.0.0.1



# PostgreSQL (leave empty to use SQLite for local dev without Postgres)

DB_NAME=bible_intelligent

DB_USER=postgres

DB_PASSWORD=postgres

DB_HOST=localhost

DB_PORT=5432



# Flutter / API client

API_BASE_URL=http://127.0.0.1:8000



# RAG / LLM — copie este ficheiro para `.env` na raiz do repositório e preencha a chave.

# NUNCA commite o ficheiro `.env` nem cole chaves reais aqui (.env.example é público).

OPENAI_API_KEY=

OPENAI_API_BASE=https://api.openai.com/v1

OPENAI_MODEL=gpt-4o-mini

# Tentativas em caso de HTTP 429 (com espera entre tentativas)

OPENAI_MAX_RETRIES=4

# Se 1, o `.env` sobrescreve variáveis de ambiente já definidas (recomendado em dev).

DOTENV_OVERRIDE=1

# RAG modo biografia (POST /api/ask com intent=biblical_biography): mais versículos no contexto

# RAG_BIOGRAPHY_TOP_SEMANTIC=56
# RAG_BIOGRAPHY_TOP_TEXT=80
# RAG_BIOGRAPHY_TOP_FINAL=56
# OPENAI_BIOGRAPHY_MAX_TOKENS=8192

# Cache semântico /api/ask (embedding da pergunta; ≥ similaridade evita RAG+OpenAI)

# SEMANTIC_ASK_CACHE_ENABLED=1
# SEMANTIC_ASK_CACHE_MIN_SIMILARITY=0.9
# SEMANTIC_ASK_CACHE_LOOKBACK=400



# Embeddings (sentence-transformers; default all-MiniLM-L6-v2)

# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2


